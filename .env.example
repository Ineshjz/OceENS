# Copy this file to `.env` (`cp .env.example .env`): the application and
# docker-compose.yaml read it at startup. Each variable is described in the
# README's Configuration section, which is the reference.

# ┌─ Authentication ──────────────────────────────────────────────────────────┐
# `dev`: development sign-in (GET /dev/login), no identity provider. Anyone can
# sign in as any user: NEVER USE IN PRODUCTION.
# `entra` (default when unset): Microsoft Entra ID, see the section below.
# `dev` is shipped here so that a fork starts without Entra credentials: every
# deployment requires `AUTH_MODE` unset or `entra` (README deployment checklist).
AUTH_MODE=dev

# Key required by the development sign-in (empty = open sign-in).
DEV_LOGIN_KEY=

# Comma-separated e-mail domains allowed to sign in.
ALLOWED_DOMAINS=epf.fr,epfedu.fr

# Session cookie signing key. Required with AUTH_MODE=entra, optional with
# dev: see "SECRET_KEY" in the README's Configuration section.
SECRET_KEY=
# └───────────────────────────────────────────────────────────────────────────┘

# ┌─ Microsoft Entra ID (AUTH_MODE=entra only) ───────────────────────────────┐
# Leave commented out in dev mode; uncomment and fill in for AUTH_MODE=entra.
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_TENANT_ID=
# REDIRECT_URI=https://[CHANGE_THIS]/auth/callback
# └───────────────────────────────────────────────────────────────────────────┘

# ┌─ Database ────────────────────────────────────────────────────────────────┐
# Folder of the SQLite database (default: database/ at the project root).
# With docker compose, the host folder mounted into the container.
LOCAL_DATABASE_DIR=
# └───────────────────────────────────────────────────────────────────────────┘

# ┌─ LLM summaries ───────────────────────────────────────────────────────────┐
# Key of the default LLM provider (Ollama EPF). Empty: the application starts,
# and requested summaries are marked as a configuration error.
LLM_API_KEY=

# 1 starts the summaries daemon alongside uvicorn (use it with docker compose).
# Leave empty where launch.sh runs, as it starts the daemon itself.
RUN_SUMMARIES_DAEMON=
# └───────────────────────────────────────────────────────────────────────────┘
